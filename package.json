{
  "name": "@workstation/omp-herdsman",
  "version": "0.15.0",
  "type": "module",
  "description": "Work-in-progress An OMP-native port of Pi Herdsman for asynchronous agents and Herdr-backed orchestration.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Battlelamb/omp-herdsman.git"
  },
  "bugs": {
    "url": "https://github.com/Battlelamb/omp-herdsman/issues"
  },
  "homepage": "https://github.com/Battlelamb/omp-herdsman#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "subagent",
    "subagents",
    "agents",
    "ai-agents",
    "coding-agents",
    "coding-agent-orchestration",
    "multi-agent",
    "multi-agent-coding",
    "agent-fleet",
    "parallel-agents",
    "parallel-coding-agents",
    "background-agents",
    "nested-agents",
    "agent-orchestration",
    "orchestration",
    "delegation",
    "supervision",
    "herdr",
    "pi-herdsman"
  ],
  "omp": {
    "extensions": [
      "./extension/index.ts"
    ],
    "skills": [
      "."
    ],
    "image": "https://raw.githubusercontent.com/boadij/pi-herdsman/main/docs/assets/thumbnail.webp"
  },
  "scripts": {
    "test": "node --experimental-test-module-mocks --import=./scripts/test-env.mjs --test --test-timeout=10000",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "package:audit": "node scripts/package-audit.mjs",
    "validate": "npm run check && npm run build && npm run package:audit",
    "release:check": "npm run validate && npm publish --dry-run --ignore-scripts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@oh-my-pi/pi-ai": "workspace:*",
    "@oh-my-pi/pi-catalog": "workspace:*",
    "@oh-my-pi/pi-coding-agent": "workspace:*",
    "@oh-my-pi/pi-tui": "workspace:*",
    "@oh-my-pi/pi-utils": "workspace:*",
    "@sinclair/typebox": "catalog:"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "README.md",
    "SKILL.md",
    "LICENSE",
    "docs",
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "private": true,
  "upstreamRepository": "https://github.com/boadij/pi-herdsman",
  "upstreamRevision": "c827b0bea1742753f19eed63efa66b48ba90c42c"
}
